<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RootNamespace>DriveCrawl.Tests</RootNamespace>
    <AssemblyName>DriveCrawl.Tests</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- UseWPF drops System.IO from implicit usings to avoid a clash with System.Windows.Shapes.Path. -->
    <Using Include="System.IO" />
    <Using Include="Xunit" />
    <Using Include="Shouldly" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\DriveCrawl Win32 App.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NSubstitute" Version="6.2.0" />
    <PackageReference Include="Shouldly" Version="4.3.0" />
    <PackageReference Include="Xunit.StaFact" Version="4.0.24" />
    <PackageReference Include="xunit.v3" Version="4.0.3" />
  </ItemGroup>

</Project>
