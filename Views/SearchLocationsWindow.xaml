<Window x:Class="DriveCrawl_Win32_App.Views.SearchLocationsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DriveCrawl - Search locations"
        Width="660" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#0F1117"
        Icon="pack://application:,,,/DriveCrawl Win32 App;component/Resources/app_icon.ico"
        FontFamily="Segoe UI"
        Closing="Window_Closing">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <SolidColorBrush x:Key="P1Green"  Color="#22C55E"/>
        <SolidColorBrush x:Key="P2Blue"   Color="#3B82F6"/>
        <SolidColorBrush x:Key="P3Yellow" Color="#EAB308"/>
        <SolidColorBrush x:Key="P4Orange" Color="#F97316"/>
        <SolidColorBrush x:Key="PDefault" Color="#6B7280"/>

        <Style x:Key="PriorityDotStyle" TargetType="Ellipse">
            <Setter Property="Width" Value="11"/>
            <Setter Property="Height" Value="11"/>
            <Setter Property="Fill" Value="{StaticResource PDefault}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Priority}" Value="1"><Setter Property="Fill" Value="{StaticResource P1Green}"/></DataTrigger>
                <DataTrigger Binding="{Binding Priority}" Value="2"><Setter Property="Fill" Value="{StaticResource P2Blue}"/></DataTrigger>
                <DataTrigger Binding="{Binding Priority}" Value="3"><Setter Property="Fill" Value="{StaticResource P3Yellow}"/></DataTrigger>
                <DataTrigger Binding="{Binding Priority}" Value="4"><Setter Property="Fill" Value="{StaticResource P4Orange}"/></DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="OptionDotStyle" TargetType="Ellipse" BasedOn="{StaticResource PriorityDotStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Value}" Value="1"><Setter Property="Fill" Value="{StaticResource P1Green}"/></DataTrigger>
                <DataTrigger Binding="{Binding Value}" Value="2"><Setter Property="Fill" Value="{StaticResource P2Blue}"/></DataTrigger>
                <DataTrigger Binding="{Binding Value}" Value="3"><Setter Property="Fill" Value="{StaticResource P3Yellow}"/></DataTrigger>
                <DataTrigger Binding="{Binding Value}" Value="4"><Setter Property="Fill" Value="{StaticResource P4Orange}"/></DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DialogButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#2A3048"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#1F2430"/>
                                <Setter Property="Foreground" Value="#4A5568"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource DialogButtonStyle}">
            <Setter Property="Background" Value="#3B82F6"/>
        </Style>

        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#7A8499"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="Transparent" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#252E44"/>
                                <Setter Property="Foreground" Value="#E8ECF4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PriorityOptionStyle" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="pill" BorderBrush="#2A3048" BorderThickness="1" CornerRadius="11" Padding="8,3" Background="Transparent">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Style="{StaticResource OptionDotStyle}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="label" Text="{Binding Value}" Foreground="#7A8499" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="pill" Property="BorderBrush" Value="#4A9EFF"/>
                                <Setter TargetName="pill" Property="Background" Value="#18233A"/>
                                <Setter TargetName="label" Property="Foreground" Value="#E8ECF4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <StackPanel Margin="22,20,22,18">
        <TextBlock Text="Search locations" Foreground="#E8ECF4" FontSize="18" FontWeight="SemiBold"/>
        <TextBlock Foreground="#7A8499" FontSize="12.5" TextWrapping="Wrap" Margin="0,5,0,14"
                   Text="The folders and drives DriveCrawl searches. In duplicate results, the copy under the higher priority number is kept. Removing a location never touches the files on disk."/>

        <!-- Empty state -->
        <Border Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVisibility}}"
                BorderBrush="#3A4460" BorderThickness="1" CornerRadius="6" Padding="18,22" Margin="0,0,0,10">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="No search locations yet" Foreground="#E8ECF4" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                <TextBlock Text="Add the folders or drives you want DriveCrawl to search." Foreground="#7A8499" FontSize="12.5"
                           HorizontalAlignment="Center" Margin="0,4,0,12"/>
                <Button Content="Add your first location" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Center"
                        Click="AddLocationButton_Click"/>
            </StackPanel>
        </Border>

        <!-- Locations list -->
        <Border Background="#161B27" BorderBrush="#2A3048" BorderThickness="1" CornerRadius="5"
                Visibility="{Binding HasLocations, Converter={StaticResource BoolToVisibility}}">
            <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Locations}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#20273A" BorderThickness="0,0,0,1" Padding="12,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Style="{StaticResource PriorityDotStyle}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Grid.Column="1" Text="{Binding PriorityLabel}" Foreground="#7A8499" FontSize="11" FontWeight="SemiBold"
                                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock x:Name="PathText" Text="{Binding Path}" Foreground="#E8ECF4" FontFamily="Consolas" FontSize="12.5"
                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}"/>
                                        <TextBlock Text="{Binding OverlapWarning}" Foreground="#F59E0B" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"
                                                   Visibility="{Binding HasOverlapWarning, Converter={StaticResource BoolToVisibility}}"/>
                                    </StackPanel>
                                    <TextBlock x:Name="StatusText" Grid.Column="3" Text="{Binding StatusText}" Foreground="#7A8499" FontSize="11.5"
                                               VerticalAlignment="Center" Margin="10,0,8,0"/>
                                    <StackPanel x:Name="RowActions" Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="&#xE70F;" ToolTip="Edit" Style="{StaticResource IconButtonStyle}" Click="EditLocationButton_Click"/>
                                        <Button Content="&#xE74D;" ToolTip="Remove" Style="{StaticResource IconButtonStyle}" Click="RemoveLocationButton_Click"/>
                                    </StackPanel>
                                    <Button x:Name="UndoButton" Grid.Column="4" Content="&#xE7A7;" ToolTip="Undo remove" Visibility="Collapsed"
                                            Style="{StaticResource IconButtonStyle}" Foreground="#4A9EFF" Click="UndoRemoveButton_Click"/>
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsMarkedForRemoval}" Value="True">
                                    <Setter TargetName="PathText" Property="TextDecorations" Value="Strikethrough"/>
                                    <Setter TargetName="PathText" Property="Foreground" Value="#4A5568"/>
                                    <Setter TargetName="StatusText" Property="Text" Value="Will be removed"/>
                                    <Setter TargetName="RowActions" Property="Visibility" Value="Collapsed"/>
                                    <Setter TargetName="UndoButton" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsOnline}" Value="False">
                                    <Setter TargetName="StatusText" Property="Foreground" Value="#F59E0B"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <Button Content="+  Add location..." Style="{StaticResource DialogButtonStyle}" HorizontalAlignment="Left" Margin="0,10,0,0"
                Visibility="{Binding HasLocations, Converter={StaticResource BoolToVisibility}}"
                Click="AddLocationButton_Click"/>

        <!-- Add / edit panel -->
        <Border Visibility="{Binding IsEditorOpen, Converter={StaticResource BoolToVisibility}}"
                Background="#121A2B" BorderBrush="#4A9EFF" BorderThickness="1" CornerRadius="5" Padding="14,12" Margin="0,12,0,0">
            <StackPanel>
                <TextBlock Text="{Binding EditorTitle}" Foreground="#E8ECF4" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,10"/>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Folder" Foreground="#7A8499" VerticalAlignment="Center"/>
                    <TextBox x:Name="EditorPathBox" Grid.Column="1" Text="{Binding EditorPath, UpdateSourceTrigger=PropertyChanged}"
                             Background="#1E2536" Foreground="#E8ECF4" BorderBrush="#2A3048" FontFamily="Consolas" FontSize="12.5"
                             Padding="6,4" VerticalContentAlignment="Center"/>
                    <Button Grid.Column="2" Content="Browse..." Style="{StaticResource DialogButtonStyle}" Margin="8,0,0,0"
                            Click="BrowseButton_Click"/>
                </Grid>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="Priority" Foreground="#7A8499" Width="70" VerticalAlignment="Center"/>
                    <ItemsControl ItemsSource="{Binding PriorityOptions}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <RadioButton GroupName="EditorPriority" Style="{StaticResource PriorityOptionStyle}"
                                             IsChecked="{Binding IsSelected, Mode=TwoWay}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                <CheckBox IsChecked="{Binding EditorIsExternal, Mode=TwoWay}" Margin="70,0,0,4" Foreground="#E8ECF4" FontSize="12.5"
                          Content="External / removable drive (may be unplugged)"/>
                <TextBlock Text="{Binding EditorError}" Foreground="#F59E0B" FontSize="12" TextWrapping="Wrap" Margin="70,6,0,0"
                           Visibility="{Binding HasEditorError, Converter={StaticResource BoolToVisibility}}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                    <Button Content="Cancel" Style="{StaticResource DialogButtonStyle}" Margin="0,0,8,0" Click="CancelEditButton_Click"/>
                    <Button Content="Apply" Style="{StaticResource PrimaryButtonStyle}" Click="ApplyEditButton_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Footer -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Cancel" Style="{StaticResource DialogButtonStyle}" IsCancel="True" Margin="0,0,10,0" Click="CancelButton_Click"/>
            <Button Content="Save changes" Style="{StaticResource PrimaryButtonStyle}" IsEnabled="{Binding CanSave}" Click="SaveButton_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
